import time
import torch
from sentence_transformers import CrossEncoder

print("Initializing CrossEncoder model (cross-encoder/ms-marco-MiniLM-L-2-v2)...")
start = time.perf_counter()
model = CrossEncoder("cross-encoder/ms-marco-MiniLM-L-2-v2")
print(f"Model loaded in {time.perf_counter() - start:.2f} seconds.")

# Test pairs
pairs = [
    # True positives (highly similar)
    ("What is the capital of France?", "What is the capital city of France?"),
    ("How do I write quicksort in python?", "write a quicksort implementation in python"),
    # False positives (similar structure, different entities/meanings)
    ("Show status of user 123", "Show status of user 456"),
    ("How do I enable the firewall?", "How do I disable the firewall?"),
    ("Tell me about the CEO of Google", "Tell me about the CEO of Microsoft"),
    ("Get weather in Tokyo", "Get weather in Zurich"),
]

for p1, p2 in pairs:
    start_eval = time.perf_counter()
    score = model.predict((p1, p2))
    # Apply sigmoid
    prob = 1 / (1 + torch.exp(-torch.tensor(score)).item())
    latency = (time.perf_counter() - start_eval) * 1000
    print(f"P1: '{p1}'")
    print(f"P2: '{p2}'")
    print(f"-> Raw logit: {score:.4f} | Prob (Sigmoid): {prob:.4f} | Latency: {latency:.2f}ms")
    print("-" * 50)
